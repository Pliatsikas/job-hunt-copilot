# Neon pooled connection string — used by the running app (lib/db.ts)
DATABASE_URL=

# Neon direct connection string — used by Prisma Migrate only (prisma.config.ts)
DIRECT_URL=

# openssl rand -base64 32 — required
AUTH_SECRET=

# Optional. Leave empty to run without GitHub sign-in (credentials login still
# works, and the GitHub button is hidden). Both are needed to enable it.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# gemini | groq | ollama | anthropic
# Groq is the deployed default: its free tier meters tokens per minute rather
# than requests per day, which is the difference between a two-visitors-a-day
# demo and something usable. Gemini stays fully configured — it is the
# comparison provider for the M9 evals and the fallback.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GROQ_API_KEY=

# Kill switch. Set to false to stop all model calls immediately, independent
# of every counter below.
LLM_ENABLED=true

# ---------------------------------------------------------------------------
# Daily budgets. Every value has a default in lib/env.ts, so an empty entry
# here is not an unset limit — it is the default. Switching provider means
# changing these numbers, never the enforcement logic.
#
# The defaults are the GROQ profile, measured against the live endpoint rather
# than quoted from documentation. `openai/gpt-oss-120b` returns:
#     x-ratelimit-limit-requests: 1000   reset 1m26.4s  (= 86400/1000 → per day)
#     x-ratelimit-limit-tokens:   8000   reset 547ms    (→ per minute)
# so the daily ceiling is 1,000 requests. An analysis measured 2,033–2,979
# tokens (mean 2,452), which is the ~2,500/operation the budgets assume.
#
# The per-minute token bucket is deliberately not counted here: a 429 from it
# carries no quota marker, so it is classified as transient and waited out by
# lib/llm/retry.ts. These counters are for allowances that do not free
# themselves within a request.
# ---------------------------------------------------------------------------
USER_DAILY_REQUESTS=12
USER_DAILY_TOKENS=40000
ADMIN_DAILY_REQUESTS=150
ADMIN_DAILY_TOKENS=400000

# GLOBAL_* is the whole project's daily budget, held below the provider's
# measured ceiling so a hard provider 429 is never the first sign of trouble.
# GLOBAL_USER_SHARE_* is how much of it USER accounts may spend between them;
# the remainder is reserved for ADMIN, so a busy day from visitors degrades
# the public demo without locking the owner out of their own app.
GLOBAL_DAILY_REQUESTS=900
GLOBAL_DAILY_TOKENS=2250000
GLOBAL_USER_SHARE_REQUESTS=600
GLOBAL_USER_SHARE_TOKENS=1500000

# --- Gemini profile -------------------------------------------------------
# Swap to these when LLM_PROVIDER=gemini. The free tier caps requests per
# model per day, measured at 20 for gemini-3.5-flash — two orders of magnitude
# tighter than Groq, and the reason Groq is the deployed default.
#
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini-3.5-flash
#   USER_DAILY_REQUESTS=4
#   USER_DAILY_TOKENS=12000
#   ADMIN_DAILY_REQUESTS=12
#   ADMIN_DAILY_TOKENS=40000
#   GLOBAL_DAILY_REQUESTS=18          # of the measured 20; 2 held back
#   GLOBAL_DAILY_TOKENS=50000
#   GLOBAL_USER_SHARE_REQUESTS=12     # remaining 6 reserved for ADMIN
#   GLOBAL_USER_SHARE_TOKENS=34000
# --------------------------------------------------------------------------

# IP rate limits on the auth endpoints. Registration is priced highest: each
# new account mints a fresh daily budget, which is the cheapest abuse there is.
REGISTER_LIMIT_PER_HOUR=5
REGISTER_LIMIT_PER_DAY=10
LOGIN_LIMIT_PER_15_MIN=10
