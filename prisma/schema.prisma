generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Connection URLs live in prisma.config.ts (CLI) and lib/db.ts (runtime, via a
// driver adapter) — Prisma 7 removed datasource url/directUrl from this file.

enum Role {
  USER
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified DateTime? // required by @auth/prisma-adapter's AdapterUser contract
  name          String?
  passwordHash  String? // null όταν μπαίνει με GitHub
  image         String?
  // Χαλαρά όρια για τον owner, ώστε το testing να μη μετράει με τα ίδια μέτρα
  // με έναν επισκέπτη (SPEC.md §6.1). Ποτέ από registration — μόνο χειροκίνητα.
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  companies     Company[]
  applications  Application[]
  analyses      Analysis[]
  documents     Document[]
  events        Event[]
  usageCounters UsageCounter[]
  savedSearches SavedSearch[]
  leads         Lead[]
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  headline    String? // "Junior Fullstack Developer"
  location    String?
  yearsOfExp  Int      @default(0)
  cvText      String   @db.Text // η πηγή αλήθειας για κάθε prompt
  skills      String[] // normalized: trimmed, lowercased, de-duplicated
  // Specced in SPEC.md §2 but unused until a milestone needs it — nullable,
  // no writer, so it costs nothing to carry rather than re-migrate later.
  preferences Json?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Company {
  id      String  @id @default(cuid())
  userId  String
  name    String
  website String?
  notes   String? @db.Text

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, name])
}

model Application {
  id               String    @id @default(cuid())
  userId           String
  companyId        String?
  roleTitle        String
  jobUrl           String?
  jobDescription   String    @db.Text
  source           String? // LinkedIn, kariera.gr, referral...
  location         String?
  workMode         WorkMode  @default(ONSITE)
  salaryNote       String?
  status           Status    @default(SAVED)
  appliedAt        DateTime?
  nextActionAt     DateTime? // τροφοδοτεί το "Today" dashboard
  archivedAt       DateTime?
  // Denormalized from the newest Analysis. SINGLE WRITER: only the analyze
  // action (M4), in the same transaction as the Analysis insert. Stays null
  // until then — see CLAUDE.md rule 8 / SPEC.md §8 Α2.
  latestMatchScore Int?
  lastAnalyzedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  analyses  Analysis[]
  documents Document[]
  events    Event[]

  @@index([userId, status])
  @@index([userId, nextActionAt])
  @@index([userId, latestMatchScore])
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum Status {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model Event {
  id            String    @id @default(cuid())
  applicationId String
  userId        String // denormalized from Application, set in the same write (SPEC.md §8 Α1)
  type          EventType
  body          String?   @db.Text
  fromStatus    Status?
  toStatus      Status?
  at            DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, at])
  @@index([userId, at])
}

enum EventType {
  NOTE
  STATUS_CHANGE
  ANALYSIS_RUN
  DOCUMENT_CREATED
}

model Analysis {
  id            String   @id @default(cuid())
  applicationId String
  userId        String // denormalized from Application, set in the same write (SPEC.md §8 Α1)
  provider      String // "gemini" | "groq"
  model         String
  promptVersion String // e.g. "analyze@1" — lets two runs be compared
  matchScore    Int // 0-100, mirrored out of result for indexed sorting
  result        Json // the validated AnalysisResult
  // matchedSkills entries removed by the grounding check (SPEC.md §8 Α3).
  // Honest signal, shown in the UI and an eval metric in M9.
  droppedClaims Int      @default(0)
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([userId, createdAt])
}

// Per-user daily cap on provider calls — the cost brake.
/// Ένα row ανά χρήστη ανά ημέρα Αθήνας (όχι UTC — SPEC.md §6.1: το «μηδενίζει
/// τα μεσάνυχτα» πρέπει να είναι τα δικά του μεσάνυχτα). Μετράει και requests
/// και tokens: στο free tier του Groq δεσμεύουν τα requests πρώτα, στο κόστος
/// τα tokens, οπότε επιβάλλεται όποιο χτυπήσει πρώτο.
model UsageCounter {
  id           String   @id @default(cuid())
  userId       String
  day          DateTime @db.Date
  calls        Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  // Το global budget αθροίζει όλα τα rows μιας ημέρας.
  @@index([day])
}

/// Fixed-window counter ανά κλειδί (π.χ. "register:203.0.113.7"). Postgres αντί
/// για Redis: μία γραφή ανά auth attempt δεν κοστίζει τίποτα σε αυτό το traffic
/// και δεν προσθέτει ούτε dependency ούτε secret να γυρνάει (SPEC.md §6.1).
model RateLimit {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([key, windowStart])
  // Το prune σαρώνει κατά παράθυρο.
  @@index([windowStart])
}

model Document {
  id            String           @id @default(cuid())
  applicationId String
  userId        String // denormalized from Application, set in the same write (SPEC.md §8 Α1)
  type          DocType
  // Only set for follow-ups: which of the three situations produced this.
  // Nullable because a cover letter has no context.
  context       FollowUpContext?
  language      String           @default("en") // "en" | "el"
  content       String           @db.Text
  // Monotonic per (applicationId, type): regenerating keeps the old text
  // rather than overwriting it.
  version       Int              @default(1)
  createdAt     DateTime         @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, type, version])
  @@index([userId, createdAt])
}

enum DocType {
  COVER_LETTER
  CV_TAILORED
  FOLLOW_UP_EMAIL
}

enum FollowUpContext {
  AFTER_APPLYING
  AFTER_INTERVIEW
  NUDGE
}

/// Πηγές ingestion. Μόνο δημόσια, τεκμηριωμένα APIs φτιαγμένα γι' αυτή τη χρήση —
/// ποτέ HTML (SPEC.md §6.4, CLAUDE.md #4). Η λίστα είναι enum ώστε μια νέα πηγή
/// να είναι migration + adapter, όχι ένα string που εμφανίστηκε από πουθενά.
enum LeadSource {
  GREENHOUSE
  LEVER
  ARBEITNOW
  REMOTIVE
}

enum LeadStatus {
  NEW
  DISMISSED
  PROMOTED
}

/// Μια αποθηκευμένη αναζήτηση: πηγή + ερώτημα (company slug για τα board APIs,
/// λέξη-κλειδί για τα job APIs). Τρέχει χειροκίνητα· δεν υπάρχει cron.
model SavedSearch {
  id        String     @id @default(cuid())
  userId    String
  name      String
  source    LeadSource
  query     String
  lastRunAt DateTime?
  createdAt DateTime   @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads Lead[]

  @@index([userId])
}

/// Ένα εισερχόμενο posting. Ξεχωριστό από το Application: το triage είναι
/// ακριβώς το βήμα «αξίζει να γίνει αίτηση;» και ένα lead που απορρίφθηκε δεν
/// πρέπει να γεμίζει το pipeline. Το promote φτιάχνει Application.
///
/// dedupeKey = normalized(company) + normalized(title), unique ανά χρήστη:
/// η ίδια θέση από δύο πηγές (ή δύο τρεξίματα) είναι ένα lead.
model Lead {
  id             String     @id @default(cuid())
  userId         String
  savedSearchId  String?
  source         LeadSource
  externalId     String
  dedupeKey      String
  companyName    String
  roleTitle      String
  location       String?
  jobUrl         String?
  jobDescription String     @db.Text
  postedAt       DateTime?
  status         LeadStatus @default(NEW)
  // Auto-score στην άφιξη: η ίδια ανάλυση με το κουμπί, αποθηκευμένη εδώ και
  // όχι σε Application (rule 8: Application.latestMatchScore έχει έναν writer).
  matchScore     Int?
  analysis       Json?
  droppedClaims  Int?
  scoredAt       DateTime?
  applicationId  String?    @unique
  createdAt      DateTime   @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedSearch SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, status, createdAt])
}
