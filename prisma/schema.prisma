generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Connection URLs live in prisma.config.ts (CLI) and lib/db.ts (runtime, via a
// driver adapter) — Prisma 7 removed datasource url/directUrl from this file.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? // required by @auth/prisma-adapter's AdapterUser contract
  name          String?
  passwordHash  String?          // null όταν μπαίνει με GitHub
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  companies     Company[]
  applications  Application[]
  analyses      Analysis[]
  documents     Document[]
  events        Event[]
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  headline   String? // "Junior Fullstack Developer"
  location   String?
  yearsOfExp Int      @default(0)
  cvText     String   @db.Text // η πηγή αλήθειας για κάθε prompt
  skills     String[] // normalized: trimmed, lowercased, de-duplicated
  // Specced in SPEC.md §2 but unused until a milestone needs it — nullable,
  // no writer, so it costs nothing to carry rather than re-migrate later.
  preferences Json?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Company {
  id      String  @id @default(cuid())
  userId  String
  name    String
  website String?
  notes   String? @db.Text

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, name])
}

model Application {
  id             String    @id @default(cuid())
  userId         String
  companyId      String?
  roleTitle      String
  jobUrl         String?
  jobDescription String    @db.Text
  source         String?   // LinkedIn, kariera.gr, referral...
  location       String?
  workMode       WorkMode  @default(ONSITE)
  salaryNote     String?
  status         Status    @default(SAVED)
  appliedAt      DateTime?
  nextActionAt   DateTime? // τροφοδοτεί το "Today" dashboard
  archivedAt     DateTime?
  // Denormalized from the newest Analysis. SINGLE WRITER: only the analyze
  // action (M4), in the same transaction as the Analysis insert. Stays null
  // until then — see CLAUDE.md rule 8 / SPEC.md §8 Α2.
  latestMatchScore Int?
  lastAnalyzedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  analyses  Analysis[]
  documents Document[]
  events    Event[]

  @@index([userId, status])
  @@index([userId, nextActionAt])
  @@index([userId, latestMatchScore])
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum Status {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model Event {
  id            String    @id @default(cuid())
  applicationId String
  userId        String // denormalized from Application, set in the same write (SPEC.md §8 Α1)
  type          EventType
  body          String?   @db.Text
  fromStatus    Status?
  toStatus      Status?
  at            DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, at])
  @@index([userId, at])
}

enum EventType {
  NOTE
  STATUS_CHANGE
  ANALYSIS_RUN
  DOCUMENT_CREATED
}

model Analysis {
  id            String   @id @default(cuid())
  applicationId String
  userId        String // denormalized from Application, set in the same write (SPEC.md §8 Α1)
  provider      String // "gemini" | "groq"
  model         String
  promptVersion String // e.g. "analyze@1" — lets two runs be compared
  matchScore    Int // 0-100, mirrored out of result for indexed sorting
  result        Json // the validated AnalysisResult
  // matchedSkills entries removed by the grounding check (SPEC.md §8 Α3).
  // Honest signal, shown in the UI and an eval metric in M8.
  droppedClaims Int      @default(0)
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([userId, createdAt])
}

// Per-user daily cap on provider calls — the cost brake.
model UsageCounter {
  id     String   @id @default(cuid())
  userId String
  day    DateTime @db.Date
  calls  Int      @default(0)

  @@unique([userId, day])
}

model Document {
  id            String   @id @default(cuid())
  applicationId String
  userId        String // denormalized from Application, set in the same write (SPEC.md §8 Α1)
  type          DocType
  // Only set for follow-ups: which of the three situations produced this.
  // Nullable because a cover letter has no context.
  context       FollowUpContext?
  language      String   @default("en") // "en" | "el"
  content       String   @db.Text
  // Monotonic per (applicationId, type): regenerating keeps the old text
  // rather than overwriting it.
  version       Int      @default(1)
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, type, version])
  @@index([userId, createdAt])
}

enum DocType {
  COVER_LETTER
  CV_TAILORED
  FOLLOW_UP_EMAIL
}

enum FollowUpContext {
  AFTER_APPLYING
  AFTER_INTERVIEW
  NUDGE
}
